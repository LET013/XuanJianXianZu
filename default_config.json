  "性能维护": [
    {
      "Id": "XuanJian_config_enable_longrun_memory_maintenance",
      "Name": "长期运行内存整理",
      "Description": "每五年登记一次限额整理任务，每二十五年追加释放可重建缓存；仅在年度队列清空后分阶段后台执行，不再强制触发托管内存回收",
      "Type": "SWITCH",
      "BoolVal": true,
      "Callback": "XuanJianConfig:EnableLongRunMemoryMaintenanceCallBack"
    },
    {
      "Id": "XuanJian_config_highspeed_enemy_search_backoff",
      "Name": "高倍速空寻敌退避",
      "Description": "默认开启。仅在二十倍、四十倍等高倍速下，对无目标、未受击、未移动且未寻路的角色完成一次真实空搜索后，延长下一次原生寻敌重试间隔；不拦截搜索，不影响已有目标和战斗响应。",
      "Type": "SWITCH",
      "BoolVal": true,
      "Callback": "XuanJianConfig:HighSpeedEnemySearchBackoffCallBack"
    },
    {
      "Id": "XuanJian_config_performance_observation",
      "Name": "高负载性能观测",
      "Description": "默认关闭。开启后以固定缓冲记录高位延迟分布、慢帧、托管内存回收、内存占用、空寻敌、寻路请求、队列高水位和年度语义积压，每三十秒输出一次汇总；只观测，不修改玩法结果。",
      "Type": "SWITCH",
      "BoolVal": false,
      "Callback": "XuanJianConfig:PerformanceObservationCallBack"
    },
    {
