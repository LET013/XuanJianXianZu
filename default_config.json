  "公告设置": [
    {
      "Id": "XuanJian_config_enable_highrealm_announcement",
      "Name": "【修行】高境证道与晋升",
      "Description": "只对紫府／真人、金丹／真君、神丹、结璘、空证、道胎等高境晋升与重大高境结果发布天下公告；普通神通、瓶颈与转修过程只记史册",
      "Type": "SWITCH",
      "BoolVal": true,
      "Callback": "XuanJianConfig:EnableHighRealmAnnouncementCallBack"
    },
    {
      "Id": "XuanJian_config_enable_authority_position_announcement",
      "Name": "【果位】权柄与余闰位序",
      "Description": "权柄归身、离身、易位、显化、失落、裂解，以及余位、闰位首次开辟或容量扩充时发布天下公告；超额事件仍保留在果位权柄页与三书",
      "Type": "SWITCH",
      "BoolVal": true,
      "Callback": "XuanJianConfig:EnableAuthorityPositionAnnouncementCallBack"
    },
    {
      "Id": "XuanJian_config_enable_death_announcement",
      "Name": "【生死】高境陨落",
      "Description": "高境修士死亡、转生、陨落等事件发布玄鉴通知",
      "Type": "SWITCH",
      "BoolVal": true,
      "Callback": "XuanJianConfig:EnableDeathAnnouncementCallBack"
    },
    {
      "Id": "XuanJian_config_enable_lingwu_announcement",
      "Name": "【资源】灵物与金性",
      "Description": "灵物现世、寻得灵物、斩龙得灵、灵物入库以及金性产出、金性遗留等事件发布天下公告；超出公告配额的事件仍完整进入仙鉴与三书",
      "Type": "SWITCH",
      "BoolVal": true,
      "Callback": "XuanJianConfig:EnableLingWuAnnouncementCallBack"
    },
    {
      "Id": "XuanJian_config_enable_treasure_milestone_announcement",
      "Name": "【重宝】灵宝、法宝与延寿丹",
      "Description": "紫府灵宝、金丹法宝的炼成、获得与蜕变，以及九曜延寿丹等延寿丹炼制成功时发布天下公告；普通法器和普通丹药仍只记史册",
      "Type": "SWITCH",
      "BoolVal": true,
      "Callback": "XuanJianConfig:EnableTreasureMilestoneAnnouncementCallBack"
    },
    {
      "Id": "XuanJian_config_enable_highrealm_influence_announcement",
      "Name": "【家族】上修扶持与干预",
      "Description": "真人层次及以上修士（含紫府、服气真人）扶持后辈、左右族议或借外族下修布置棋局时发布玄鉴通知；关闭后真实影响和历史仍正常生效",
      "Type": "SWITCH",
      "BoolVal": true,
      "Callback": "XuanJianConfig:EnableHighRealmInfluenceAnnouncementCallBack"
    },
    {
      "Id": "XuanJian_config_enable_sect_announcement",
      "Name": "【宗门】开宗、战争与覆灭",
      "Description": "只对开宗立道、分宗、宣战、破阵、灭宗与宗门衰亡等改变山门格局的大事发布天下公告；大比、任务、讲法与日常治理只记宗门履历",
      "Type": "SWITCH",
      "BoolVal": true,
      "Callback": "XuanJianConfig:EnableSectAnnouncementCallBack"
    },
    {
      "Id": "XuanJian_config_enable_dongtian_announcement",
      "Name": "【洞天】显世、归属与关闭",
      "Description": "洞天显世、再次开启、归属变化、宗门洞天营造、洞天关闭与洞门复闭等事件发布天下公告",
      "Type": "SWITCH",
      "BoolVal": true,
      "Callback": "XuanJianConfig:EnableDongTianAnnouncementCallBack"
    },
    {
      "Id": "XuanJian_config_enable_yinsi_announcement",
      "Name": "【阴司】追索与离去",
      "Description": "阴司现身、追索、离去等事件发布玄鉴通知",
      "Type": "SWITCH",
      "BoolVal": true,
      "Callback": "XuanJianConfig:EnableYinSiAnnouncementCallBack"
    },
    {
      "Id": "XuanJian_config_enable_shi_announcement",
      "Name": "【释修】高位晋升与真灵大事",
      "Description": "只对摩诃、法相、世尊晋升，摩诃转世、庙主得地、三十二天重组、真灵归返或俱灭等高位大事发布天下公告；入释、点化、莲座迁升与日常修持只记释门履历",
      "Type": "SWITCH",
      "BoolVal": true,
      "Callback": "XuanJianConfig:EnableShiAnnouncementCallBack"
    }
  ],
  "世界生态": [
    {
