{
  "基础修炼": [
    {
      "Id": "XuanJian_config_enable_cultivation",
      "Name": "允许修炼",
      "Description": "开启后，符合条件的智慧文明种族可进入玄鉴修炼链路；关闭后所有生物都不会进入修炼链路。动物与动物亚种始终不可修炼",
      "Type": "SWITCH",
      "BoolVal": true,
      "Callback": "XuanJianConfig:EnableCultivationCallBack"
    },
    {
      "Id": "XuanJian_config_aptitude_grant_chance_percent",
      "Name": "修炼特质获得概率",
      "Description": "设置普通角色在幼年获得修炼资质的概率上限；范围25%-40%。血脉与直系高境保底另行生效。",
      "Type": "INT_SLIDER",
      "IntVal": 40,
      "MinIntVal": 25,
      "MaxIntVal": 40,
      "StepIntVal": 1,
      "Callback": "XuanJianConfig:AptitudeGrantChancePercentCallBack"
    },
    {
      "Id": "XuanJian_config_qiujinfa_chance_permille",
      "Name": "求金法参悟概率（千分制）",
      "Description": "设置普通修士求金法每次自悟的最高成功率，单位为‰；10表示10‰=1%，50表示50‰=5%。龙属因不能借家族/宗门传法，按该上限2倍结算，但仍封顶5%",
      "Type": "INT_SLIDER",
      "IntVal": 10,
      "MinIntVal": 1,
      "MaxIntVal": 50,
      "StepIntVal": 1,
      "Callback": "XuanJianConfig:QiuJinFaChancePermilleCallBack"
    },
    {
      "Id": "XuanJian_config_sword_intent_chance_percent",
      "Name": "剑意领悟概率",
      "Description": "设置普通剑修由剑元悟入剑意时的单次成功率上限；范围1%-10%。服气长庚专属的128剑气与16道剑意修炼不受此项影响",
      "Type": "INT_SLIDER",
      "IntVal": 1,
      "MinIntVal": 1,
      "MaxIntVal": 10,
      "StepIntVal": 1,
      "Callback": "XuanJianConfig:SwordIntentChancePercentCallBack"
    },
    {
      "Id": "XuanJian_config_daotai_merit_gain_curve_percent",
      "Name": "功绩比例设置",
      "Description": "调节天地功绩的获取幅度。向左降低，向右提高；只影响此后获得的功绩，不改动已经记下的功绩。",
      "Type": "INT_SLIDER",
      "IntVal": 100,
      "MinIntVal": 75,
      "MaxIntVal": 105,
      "StepIntVal": 5,
      "Callback": "XuanJianConfig:DaoTaiMeritGainCurvePercentCallBack"
    }
  ],
